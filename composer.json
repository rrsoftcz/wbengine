{
  "name": "wbengine/wbengine",
  "description": "Wbengine is open source PHP Library that is easy to use for creating websites or intranet applications.",
  "keywords": [
    "wbengine",
    "webengine",
    "framework"
  ],
  "homepage": "https://www.wbengine.org",
  "license": [
    "MIT"
  ],
  "type": "library",
  "authors": [
    {
      "name": "Radek Roza",
      "email": "roza@rrsoft.cz",
      "homepage": "http://www.rrsoft.cz/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Wbengine\\": ""
    },
    "exclude-from-classmap": [
      "/tests/",
      "/compat/"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Wbengine\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "lint": "find . -type d \\( -name vendor -o -name .git -o -name .phpunit.cache \\) -prune -o -type f -name '*.php' -print0 | xargs -0 -n1 php -d error_reporting=E_ALL -l > /dev/null"
  },
  "config": {
    "sort-packages": true
  },
  "bin": [
    "bin/wbengine.php",
    "bin/migrate-content.php",
    "bin/wbengine-mcp.php"
  ]
}
