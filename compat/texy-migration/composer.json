{
  "name": "wbengine/texy-migration",
  "description": "Optional offline Texy-to-Markdown migration bridge for WBengine 4",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "wbengine/wbengine": "^4.0",
    "texy/texy": "^3.2"
  },
  "autoload": {
    "psr-4": {
      "Wbengine\\Compat\\TexyMigration\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": {
        "symlink": false,
        "versions": {
          "wbengine/wbengine": "4.0.x-dev"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "sh bin/test"
  }
}
